+++ b/target/cheri-common/cheri_utils.h
@@ -421,6 +421,52 @@
     CAP_cc(update_otype)(c, CAP_OTYPE_SENTRY);
 }
 
+#if CAP_HAS_RETURN_SENTRIES
+/*
+ * sentries (SignetOS local extension, not ratified).  With the CPU property
+ * on, the link cjal/cjalr writes is a return sentry (CT 2) instead of a CT 1
+ * sentry.  It is local (GL clear), so only memory reached through a
+ * capability with SL -- a stack -- can hold it.
+ *
+ * The link is the caller's own PCC, so arriving through it as-is would leave
+ * the caller running from a local PCC after every call, and everything it
+ * derived from PCC afterwards would be local too.  Arriving therefore sets GL
+ * again.  That is exact because code never runs from a local PCC: a call or
+ * jump to local code faults (cheri_jump_and_link_checked), so every link was
+ * made by global code.  The one way left to run local, an exception return
+ * to a local xEPCC, gets an untagged link from any call it makes, so it can
+ * never come back global.
+ *
+ * Only the hardware makes these: yseal starts at 8, sentry makes CT 1, and
+ * cbld does not rebuild them.  A return (jalr x0, 0(ra)) accepts nothing
+ * else, and they are accepted by nothing but a return.
+ */
+static inline bool cap_is_return_sentry(const cap_register_t *c)
+{
+    return cap_get_otype_unsigned(c) == CAP_OTYPE_RETURN;
+}
+
+static inline void cap_make_return_sentry(cap_register_t *c)
+{
+    assert(c->cr_tag && cap_is_unsealed(c) &&
+           "Should only be used with unsealed capabilities");
+    const target_ulong perms = cap_get_all_perms(c);
+    if ((perms & CAP_PERM_GLOBAL) == 0) {
+        c->cr_tag = 0; /* a call from local code is never returned from */
+    }
+    CAP_cc(set_permissions)(c, perms & ~(target_ulong)CAP_PERM_GLOBAL);
+    CAP_cc(update_otype)(c, CAP_OTYPE_RETURN);
+}
+
+static inline void cap_unseal_return_sentry(cap_register_t *c)
+{
+    assert(c->cr_tag && cap_is_return_sentry(c) &&
+           "Should only be used with return sentries");
+    CAP_cc(update_otype)(c, CAP_OTYPE_UNSEALED);
+    CAP_cc(set_permissions)(c, cap_get_all_perms(c) | CAP_PERM_GLOBAL);
+}
+#endif /* CAP_HAS_RETURN_SENTRIES */
+
 // Check if num_bytes bytes at addr can be read using capability c
 static inline bool cap_is_in_bounds(const cap_register_t *c, target_ulong addr,
                                     size_t num_bytes)
