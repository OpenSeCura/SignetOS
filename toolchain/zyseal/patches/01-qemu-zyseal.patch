+/*
+ * Zyseal (CHERI ISA spec chapter 17), SignetOS local dialect.
+ *
+ * Type capabilities are ordinary capabilities whose address/bounds are
+ * reinterpreted as a range of CT-field values.  Spec section 17.3 explicitly
+ * permits an encoding to conflate the memory and type address spaces, which
+ * is what we do here, so no new capability kind or root register is needed.
+ *
+ * Both instructions clear the result tag on failure rather than trapping,
+ * matching the rest of RVY.
+ */
+void HELPER(yseal)(CPUArchState *env, uint32_t cd, uint32_t cs1, uint32_t cs2)
+{
+    const cap_register_t *auth = get_readonly_capreg(env, cs1);
+    const cap_register_t *src = get_readonly_capreg(env, cs2);
+    cap_register_t result = *src;
+    target_ulong ct = cap_get_cursor(auth);
+
+    /* 17.6: rs1 is the sealing authority, rs2 is the capability to seal. */
+    bool ok = src->cr_tag && auth->cr_tag &&
+              cap_is_unsealed(src) &&
+              cap_has_perms(auth, CAP_PERM_SEAL) &&
+              cap_is_in_bounds(auth, ct, 1) &&
+              ct >= CAP_MIN_ZYSEAL_OTYPE && ct <= CAP_MAX_REPRESENTABLE_OTYPE;
+
+    if (ok) {
+        CAP_cc(update_otype)(&result, ct);
+    } else {
+        result.cr_tag = 0;
+    }
+    update_capreg(env, cd, &result);
+}
+
+void HELPER(yunseal)(CPUArchState *env, uint32_t cd, uint32_t cs1, uint32_t cs2)
+{
+    const cap_register_t *auth = get_readonly_capreg(env, cs1);
+    const cap_register_t *src = get_readonly_capreg(env, cs2);
+    cap_register_t result = *src;
+    target_ulong ct = cap_get_cursor(auth);
+
+    /*
+     * 17.6 requires exact equality between the authority's address and the
+     * sealed capability's CT field -- unlike YSUNSEAL, which uses a subset
+     * test.  Sentries (CT == 1) are not unsealable this way.
+     */
+    bool ok = src->cr_tag && auth->cr_tag &&
+              cap_has_perms(auth, CAP_PERM_UNSEAL) &&
+              cap_is_in_bounds(auth, ct, 1) &&
+              ct >= CAP_MIN_ZYSEAL_OTYPE &&
+              ct == cap_get_otype_unsigned(src);
+
+    if (ok) {
+        CAP_cc(update_otype)(&result, CAP_OTYPE_UNSEALED);
+        /*
+         * 17.6.2: if rs1 does not grant GL, clear GL on rd.  No such clause
+         * in 17.6.1, so YSEAL does not do this.
+         *
+         * Inert without Zylevels1: cr_lvbits is then 0 and GL reads as a
+         * hardwired one.
+         */
+        if (auth->cr_lvbits > 0 && !cap_has_perms(auth, CAP_PERM_GLOBAL)) {
+            cap_set_perms(env, &result,
+                          cap_get_all_perms(&result) & ~(target_ulong)CAP_PERM_GLOBAL);
+        }
+    } else {
+        result.cr_tag = 0;
+    }
+    update_capreg(env, cd, &result);
+}
+#endif /* TARGET_CHERI_RISCV_STD_093 && CAP_HAS_ZYSEAL */
