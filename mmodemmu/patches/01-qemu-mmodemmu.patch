+/*
+ * mmodemmu exists only with the mmodemmu CPU property. Its CSR number
+ * already makes it M-only, and under CHERI csr_needs_asr() requires ASR for
+ * any access to it.
+ */
+static RISCVException have_mmodemmu(CPURISCVState *env, int csrno)
+{
+    if (!env_archcpu(env)->cfg.ext_mmodemmu) {
+        return RISCV_EXCP_ILLEGAL_INST;
+    }
+    return RISCV_EXCP_NONE;
+}
