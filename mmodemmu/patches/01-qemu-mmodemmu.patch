+/* mmodemmu: lets M-mode use the MMU (cpu_bits.h, MMODEMMU_*) */
+static RISCVException read_mmodemmu(CPURISCVState *env, int csrno,
+                                    target_ulong *val)
+{
+    *val = env->mmodemmu;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_mmodemmu(CPURISCVState *env, int csrno,
+                                     target_ulong val)
+{
+    val &= MMODEMMU_ENABLE; /* WARL: every other bit reads as zero */
+
+    /*
+     * M-mode accesses are cached in QEMU's TLB under the M-mode MMU index
+     * whether they were translated or not, so flipping ENABLE must drop
+     * them all. tlb_flush also clears the TB jump cache, and the CSR write
+     * ends the current TB, so the next instruction is fetched under the
+     * new setting.
+     */
+    if ((val ^ env->mmodemmu) & MMODEMMU_ENABLE) {
+        tlb_flush(env_cpu(env));
+    }
+    env->mmodemmu = val;
+    return RISCV_EXCP_NONE;
+}
